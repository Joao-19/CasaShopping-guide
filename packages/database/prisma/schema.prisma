// packages/database/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-1.1.x", "linux-musl-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MODELO PARA O SERVIÇO DE USERS (apps/users) ---
model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  phone        String
  password     String // Senha Hasheada
  refreshToken String? @db.Text
  profileImage String?

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// --- MODELO PARA O SERVIÇO DE ADMINS (apps/admins) ---
model Admin {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String // Senha Hasheada
  refreshToken String? @db.Text

  // Controle de Nível de Acesso
  role AdminRole @default(EDITOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

// --- MODELO PARA O SERVIÇO DE STORES (apps/stores) ---
model Store {
  id            String  @id @default(uuid())
  name          String
  slug          String? @unique
  address       String
  phone         String?
  site          String?
  logoImage     String?
  bannerImage   String?
  facebookLink  String?
  instagramLink String?
  youtubeLink   String?
  whatsapp      String?

  createdAt  DateTime  @default(now())
  modifiedAt DateTime  @updatedAt
  deletedAt  DateTime?

  products Product[]

  @@map("stores")
}

// --- MODELO PARA O SERVIÇO DE PRODUCTS (apps/products) ---
model Product {
  id          String    @id @default(uuid())
  name        String
  description String
  price       PriceTier
  categories  String[]
  tags        String?

  storeId        String
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  showStorePhone Boolean        @default(false)
  isFeatured     Boolean        @default(false)
  images         ProductImage[]
  favorites      Favorite[]

  campaignProducts CampaignProduct[]
  views            ProductView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// --- TRACKING PRÓPRIO DE VISUALIZAÇÕES (Frente 3 — Área de Dados) ---
// Uma linha por visualização de produto. Dedupe é feito no service por
// (sessionId, productId) numa janela curta, então cada linha aqui já é uma
// view "única o suficiente". `userId` é opcional (visitante anônimo).
// Origem (referrer/utm*/landingPage) é capturada no 1º acesso da sessão.
model ProductView {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String? // usuário logado, quando houver
  sessionId   String // id de sessão do navegador (base do dedupe)
  referrer    String? // document.referrer (domínio de origem)
  utmSource   String? // utm_source
  utmMedium   String? // utm_medium
  utmCampaign String? // utm_campaign
  landingPage String? // 1ª URL da sessão (path)
  viewedAt    DateTime @default(now())

  @@index([productId])
  @@index([viewedAt])
  @@index([sessionId, productId])
  @@map("product_views")
}

model ProductImage {
  id        String   @id @default(uuid())
  path      String
  index     Int
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("favorites")
}

enum PriceTier {
  LOW
  MEDIUM
  HIGH
  ON_REQUEST
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// --- MODELO PARA O SERVIÇO DE SETTINGS (API Gateway) ---
model Settings {
  id                         Int     @id @default(1)
  backgroundDesktop          String?
  backgroundMobile           String?
  advertisementBannerMobile  String? // Imagem/vídeo do banner mobile (Wide 32:9)
  advertisementBannerDesktop String? // Imagem/vídeo do banner desktop (Wide 32:9)
  advertisementBannerDisplay Int     @default(3) // 1: Mobile, 2: Desktop, 3: Both
  advertisementBannerLinkDesktop String? // URL de destino ao clicar no anúncio desktop
  advertisementBannerLinkMobile  String? // URL de destino ao clicar no anúncio mobile

  homeTitleBold   String?
  homeTitleNormal String?

  // Newsletter (pop-up auto-open na home) — configuração global (Builder V2)
  newsletterEnabled        Boolean @default(false)
  newsletterImageSide      String  @default("left") // "left" | "right"
  newsletterAccentColor    String  @default("#003ba6")
  newsletterAppearDelay    Int     @default(5) // segundos até aparecer (0/3/5/10)
  newsletterAutoClose      Boolean @default(false)
  newsletterAutoCloseDelay Int     @default(15) // segundos visível (8/15/30)
  newsletterSlideInterval  Int     @default(5) // segundos entre imagens do carrossel interno do slide
  // Segmentação: { pageTypes: string[], specificPages: string[], campaigns: string[] }
  // Por ora persistido como JSON; web aplica home-only (ver roadmap 06).
  newsletterTargeting Json?

  updatedAt DateTime @updatedAt

  @@map("settings")
}

// --- MODELO PARA O POP-UP DE NEWSLETTER (modal da home — Builder V2) ---
// Cada linha é um slide (split: imagem de um lado, conteúdo do outro).
// A ordem de exibição = campo `order`.
model NewsletterSlide {
  id                  String   @id @default(uuid())
  images              String[] @default([]) // keys do storage (ou URLs absolutas), em ordem
  name                String? // rótulo interno do slide (não exibido)
  title               String?
  description         String?
  fineprint           String?
  primaryButtonText   String?
  primaryButtonUrl    String? // "/rota" interna ou "https://" externa
  showSecondaryButton Boolean @default(false)
  secondaryButtonText String?
  secondaryButtonUrl  String?
  order               Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_slides")
}

// --- PÁGINAS DE CAMPANHA (Frente 02) — gerenciadas no API Gateway via Prisma ---
// Página temática de layout fixo: menu + banner (desktop/mobile) + título +
// vitrine de produtos. Publicada em /campanha/[slug] no site público.
model CampaignPage {
  id           String  @id @default(uuid())
  title        String
  slug         String  @unique // usado na rota pública /campanha/[slug]
  coverDesktop String? // key do storage (banner desktop)
  coverMobile  String? // key do storage (banner mobile)
  isActive     Boolean @default(true) // inativa => 404 no público
  // Seções opcionais: [{ id, title, type: "custom"|"highlights", productIds: [] }]
  // null => vitrine plana (todos os `products` num grid). CampaignProduct segue
  // sendo o pool resolvido (union dos productIds das seções).
  sections     Json?

  products CampaignProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaign_pages")
}

// Junção campanha<->produto com ordem de exibição na vitrine.
model CampaignProduct {
  id         String       @id @default(uuid())
  campaignId String
  campaign   CampaignPage @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  order      Int          @default(0)

  createdAt DateTime @default(now())

  @@unique([campaignId, productId])
  @@map("campaign_products")
}
