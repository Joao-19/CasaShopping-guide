// packages/database/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-1.1.x", "linux-musl-arm64-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- MODELO PARA O SERVIÇO DE USERS (apps/users) ---
model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  phone        String
  password     String // Senha Hasheada
  refreshToken String? @db.Text

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// --- MODELO PARA O SERVIÇO DE ADMINS (apps/admins) ---
model Admin {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String // Senha Hasheada
  refreshToken String? @db.Text

  // Controle de Nível de Acesso
  role AdminRole @default(EDITOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

// --- MODELO PARA O SERVIÇO DE STORES (apps/stores) ---
model Store {
  id            String  @id @default(uuid())
  name          String
  address       String
  phone         String?
  site          String?
  logoImage     String?
  facebookLink  String?
  instagramLink String?
  youtubeLink   String?

  createdAt  DateTime  @default(now())
  modifiedAt DateTime  @updatedAt
  deletedAt  DateTime?

  @@map("stores")
}
