# ============================================================================
# Variaveis da STACK Portainer — casashopping em guiacasashopping.loopera.com.br
# (usar com docker-compose.loopera.yml, atras do nginx central WePlanner-Infra)
# ----------------------------------------------------------------------------
# Preencher na UI do Portainer (Stack > Environment variables).
# NAO comitar segredos reais — isto e so um modelo.
# ============================================================================

# --- Versao da imagem -------------------------------------------------------
# Default do compose ja e :prod. So defina TAG p/ fixar imutavel (rollback).
# TAG=prod

# --- Banco de dados (Postgres embutido, interno) ----------------------------
DB_USER=admin
DB_PASSWORD=TROQUE-senha-forte
DB_NAME=casashopping

# --- JWT / auth -------------------------------------------------------------
JWT_SECRET=TROQUE-32-chars-no-minimo
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=TROQUE-refresh-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Admin inicial (seed) ---------------------------------------------------
ADMIN_EMAIL=admin@loopera.com.br
ADMIN_PASSWORD=TROQUE-senha-forte
ADMIN_NAME=Admin

# --- Storage (MinIO embutido) -----------------------------------------------
STORAGE_USER=admin
STORAGE_PASSWORD=TROQUE-senha-forte
MINIO_BUCKET_NAME=casashopping
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=50

# >>> ENDPOINT PUBLICO DE MIDIA (servido pelo nginx central em /minio/) <<<
# O browser carrega imagens por aqui. Sem isto, as fotos quebram.
MINIO_PUBLIC_ENDPOINT=https://guiacasashopping.loopera.com.br/minio
STORAGE_URL=https://guiacasashopping.loopera.com.br/minio/casashopping

# ============================================================================
# >>> VARIAVEIS NOVAS DAS ROTAS (o que muda por causa do dominio novo) <<<
# ============================================================================
# CORS: dominio final (https). So o dominio publico — nao precisa das portas.
CORS_ORIGIN=https://guiacasashopping.loopera.com.br

# URLs publicas consumidas pelo browser (resolvidas em RUNTIME — sem rebuild):
NEXT_PUBLIC_API_URL=https://guiacasashopping.loopera.com.br/api
NEXT_PUBLIC_API_HOST=guiacasashopping.loopera.com.br
NEXT_PUBLIC_WEB_URL=https://guiacasashopping.loopera.com.br

# basePath (DEVE casar com o build das imagens e com o nginx central):
#   web   -> raiz  (vazio)
#   admin -> /admin
WEB_BASE_PATH=
ADMIN_BASE_PATH=/admin

# --- Analytics (opcional) ---------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# --- Legado (gateway le, nao usado aqui) ------------------------------------
DEPLOY_PASSWORD=
DOCKERHUB_PASSWORD=
</content>
