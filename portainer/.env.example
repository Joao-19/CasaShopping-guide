# ============================================================================
# Variaveis da STACK do Portainer (CasaShopping via GHCR)
# ----------------------------------------------------------------------------
# Os NOMES das variaveis sao identicos aos do .env de producao atual — este
# stack apenas as consome via UI do Portainer (Stack > Environment variables).
# Crie DUAS stacks: a de DEV usa docker-compose.dev.yml, a de PROD usa
# docker-compose.prod.yml. Mude as URLs/segredos por ambiente.
# NAO comite valores reais de segredo aqui — e so um modelo.
# ============================================================================

# --- Versao da imagem (canal publicado pelos workflows) ---------------------
#   dev  -> imagens do push em `dev-deploy`   (docker-compose.dev.yml ja usa)
#   prod -> imagens do push em `main`         (docker-compose.prod.yml ja usa)
# Cada compose ja tem o default do seu canal; so defina TAG aqui para fixar
# uma tag IMUTAVEL (rollback), ex.: TAG=dev-20260621-1530-a1b2c3d
# TAG=dev

# --- Banco de dados (EXTERNO, reutilizado) ----------------------------------
# A stack NAO sobe postgres proprio. Reutiliza um banco JA EXISTENTE (host
# `postgres`, pela rede DB_NETWORK_NAME) usando um SCHEMA proprio. NAO precisa
# criar database nem schema na mao: o `prisma migrate deploy` cria o schema
# `casashopping` sozinho se nao existir (igual cria as tabelas).
#   - DATABASE_URL : aponte para o banco existente + ?schema=casashopping.
#                    Use o nome do banco que ja existe (POSTGRES_DB do postgres
#                    da infra). NAO um banco novo.
#   - DIRECT_URL   : repita o DATABASE_URL (o app nao usa hoje; aceito p/ padrao).
#   - DB_NETWORK_NAME : nome da rede docker EXTERNA onde o `postgres` vive.
DATABASE_URL=postgres://USUARIO:SENHA@postgres:5432/BANCO_EXISTENTE?schema=casashopping
DIRECT_URL=postgres://USUARIO:SENHA@postgres:5432/BANCO_EXISTENTE?schema=casashopping
DB_NETWORK_NAME=infra-network

# --- JWT / auth -------------------------------------------------------------
JWT_SECRET=troque-isto-32-chars-no-minimo
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=troque-isto-refresh-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Admin inicial (seed pelo servico auth) ---------------------------------
ADMIN_EMAIL=admin@casashopping.com
ADMIN_PASSWORD=troque-isto
ADMIN_NAME=Admin

# --- Storage (MinIO embutido) -----------------------------------------------
STORAGE_USER=admin
STORAGE_PASSWORD=troque-isto
MINIO_BUCKET_NAME=casashopping
MINIO_PUBLIC_ENDPOINT=http://SEU-DOMINIO:9000
STORAGE_URL=http://SEU-DOMINIO:9000/casashopping
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=50

# --- Alternativa: Cloudflare R2 (S3-compativel) -----------------------------
# O storage-service e S3 puro, entao da pra usar R2 so trocando o env abaixo
# (e configurando bucket + dominio publico + CORS no painel da Cloudflare).
# Setup Cloudflare: criar bucket R2, gerar token S3 (Access Key/Secret),
# habilitar dominio publico (r2.dev ou custom) e CORS (PUT do seu dominio).
#   S3_REGION=auto                  (R2 exige "auto"; MinIO usa us-east-1)
#   STORAGE_SKIP_BUCKET_SETUP=true  (R2 nao suporta PutBucketPolicy/CORS via API)
#   STORAGE_USER=<R2 Access Key ID>        (ATENCAO: e STORAGE_USER, nao MINIO_ROOT_USER)
#   STORAGE_PASSWORD=<R2 Secret Access Key> (ATENCAO: e STORAGE_PASSWORD, nao MINIO_ROOT_PASSWORD)
#   MINIO_BUCKET_NAME=<nome do bucket R2>
#   MINIO_PUBLIC_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   (endpoint S3, upload)
#   STORAGE_URL=https://<dominio-publico-r2>/<bucket>                    (URL publica, leitura)
# Nesse modo voce pode remover o servico `storage` (MinIO) do compose.

# --- URLs publicas / CORS (consumidas pelo browser) -------------------------
CORS_ORIGIN=http://SEU-DOMINIO,http://SEU-DOMINIO:3001,http://SEU-DOMINIO:3002
NEXT_PUBLIC_API_URL=http://SEU-DOMINIO/api
NEXT_PUBLIC_API_HOST=SEU-DOMINIO
NEXT_PUBLIC_WEB_URL=http://SEU-DOMINIO

# --- basePath (DEVE casar com o build dos workflows) ------------------------
# Os workflows buildam: web na raiz (vazio) e admin em /admin.
WEB_BASE_PATH=
ADMIN_BASE_PATH=/admin

# --- Analytics (opcional) ---------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# --- Legado (gateway le, mas so usado pelo fluxo Watchtower antigo) ---------
# Pode deixar vazios nesta stack (nao ha watchtower aqui).
DEPLOY_PASSWORD=
DOCKERHUB_PASSWORD=
