# ============================================================================
# Variaveis da STACK do Portainer (CasaShopping via GHCR)
# ----------------------------------------------------------------------------
# Cole estas variaveis em: Portainer > Stack > Environment variables.
# Crie DUAS stacks (dev e prod) com a mesma compose, mudando TAG e as URLs.
# NAO comite valores reais de segredo neste arquivo — ele e so um modelo.
# ============================================================================

# --- Versao da imagem (canal publicado pelos workflows) ---------------------
#   dev    -> imagens do push em `dev-deploy`
#   stable -> imagens do push em `main`
TAG=stable

# Namespace das imagens no GHCR (so mude se trocar o owner do repo)
IMAGE_PREFIX=ghcr.io/joao-19/casashopping

# --- Rede / portas do host --------------------------------------------------
HTTP_PORT=80
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Banco de dados ---------------------------------------------------------
# Opcao A (self-contained): use o postgres da propria stack (default abaixo).
# Opcao B (gerenciado): aponte DATABASE_URL pro Neon/RDS e remova o servico
#   `database` do compose.
DB_USER=admin
DB_PASSWORD=troque-isto
DB_NAME=casashopping
DATABASE_URL=postgresql://admin:troque-isto@database:5432/casashopping?schema=public

# --- JWT / auth -------------------------------------------------------------
JWT_SECRET=troque-isto-32-chars-no-minimo
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=troque-isto-refresh-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Admin inicial (seed pelo servico auth) ---------------------------------
ADMIN_EMAIL=admin@casashopping.com
ADMIN_PASSWORD=troque-isto
ADMIN_NAME=Admin

# --- Storage (MinIO embutido) -----------------------------------------------
STORAGE_USER=admin
STORAGE_PASSWORD=troque-isto
MINIO_BUCKET_NAME=casashopping
# Endpoint publico do MinIO (como o browser acessa). Ajuste pro dominio real.
MINIO_PUBLIC_ENDPOINT=http://SEU-DOMINIO:9000
STORAGE_URL=http://SEU-DOMINIO:9000/casashopping
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=50

# --- URLs publicas (consumidas pelo browser via Next) -----------------------
# Como o nginx da stack expoe a API em /api, o padrao costuma ser o dominio + /api
CORS_ORIGIN=http://SEU-DOMINIO
NEXT_PUBLIC_API_URL=http://SEU-DOMINIO/api
NEXT_PUBLIC_API_HOST=SEU-DOMINIO
NEXT_PUBLIC_WEB_URL=http://SEU-DOMINIO

# --- Analytics (opcional) ---------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
